{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "trailingSlash": true,
  "functions": {
    "api/lead.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/u/(.+)",
      "destination": "/perfil-antigo/"
    },
    {
      "source": "/pt-BR/(.+)",
      "destination": "/perfil-antigo/"
    }
  ],
  "redirects": [
    {
      "source": "/backoffice(/)?",
      "destination": "https://backoffice-v2.hypeapp.com.br/sign-in",
      "permanent": false
    },
    {
      "source": "/backoffice/:path+",
      "destination": "https://backoffice-v2.hypeapp.com.br/:path+",
      "permanent": false
    },
    {
      "source": "/u(/)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pt-BR(/)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/politica-de-privacidade(/.*)?",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/privacidade/",
      "permanent": true
    },
    {
      "source": "/privacidade(/.*)?",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/privacidade/",
      "permanent": true
    },
    {
      "source": "/privacy(/.*)?",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/privacidade/",
      "permanent": true
    },
    {
      "source": "/privacy-policy(/.*)?",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/privacidade/",
      "permanent": true
    },
    {
      "source": "/termos-de-uso(/.*)?",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/termos/",
      "permanent": true
    },
    {
      "source": "/termos(/.*)?",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/termos/",
      "permanent": true
    },
    {
      "source": "/terms(/.*)?",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/termos/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/legal/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/$1",
      "permanent": true
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "teste.hypeapp.com.br"
        }
      ],
      "destination": "/robots-homologacao.txt",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path([A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*)/index.html",
      "destination": "/:path/",
      "permanent": true
    },
    {
      "source": "/interesse/criadores(/.*)?",
      "destination": "/baixar/",
      "permanent": false
    },
    {
      "source": "/interesse/marcas(/.*)?",
      "destination": "/contato/marcas/",
      "permanent": false
    },
    {
      "source": "/interesse(/.*)?",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pre-cadastro(/.*)?",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ajuda(/.*)?",
      "destination": "/perguntas-frequentes/",
      "permanent": false
    },
    {
      "source": "/como-funciona/",
      "destination": "/criadores/#como-funciona",
      "permanent": false
    },
    {
      "source": "/funcionalidades/",
      "destination": "/marcas/#funcionalidades",
      "permanent": false
    },
    {
      "source": "/contato/parcerias/",
      "destination": "/contato/",
      "permanent": false
    },
    {
      "source": "/direitos-sobre-dados(/.*)?",
      "destination": "/privacidade/#direitos",
      "permanent": false
    },
    {
      "source": "/mapa-do-site/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/criador(/.*)?",
      "destination": "/criadores/",
      "permanent": true
    },
    {
      "source": "/creators(/.*)?",
      "destination": "/criadores/",
      "permanent": true
    },
    {
      "source": "/marca(/.*)?",
      "destination": "/marcas/",
      "permanent": true
    },
    {
      "source": "/agencias(/.*)?",
      "destination": "/marcas/#agencias",
      "permanent": true
    },
    {
      "source": "/download(/.*)?",
      "destination": "/baixar/",
      "permanent": true
    },
    {
      "source": "/login(/.*)?",
      "destination": "/entrar/",
      "permanent": true
    },
    {
      "source": "/faq(/.*)?",
      "destination": "/perguntas-frequentes/",
      "permanent": true
    },
    {
      "source": "/politica-de-privacidade(/.*)?",
      "destination": "/privacidade/",
      "permanent": true
    },
    {
      "source": "/termos-de-uso(/.*)?",
      "destination": "/termos/",
      "permanent": true
    },
    {
      "source": "/excluir-conta(/.*)?",
      "destination": "/exclusao-de-conta/",
      "permanent": true
    },
    {
      "source": "/exclusao(/.*)?",
      "destination": "/exclusao-de-conta/",
      "permanent": true
    },
    {
      "source": "/exclusao",
      "destination": "/exclusao-de-conta/",
      "permanent": true
    },
    {
      "source": "/murais-campanhas(/.*)?",
      "destination": "/criadores/",
      "permanent": true
    },
    {
      "source": "/blog/quanto-cobrar-por-reels(/.*)?",
      "destination": "/blog/quanto-cobrar-por-uma-publi/",
      "permanent": true
    },
    {
      "source": "/blog/media-kit-link-ou-pdf(/.*)?",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blog/permuta-recebido-ou-campanha-paga(/.*)?",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/Privacidade.html",
      "destination": "/privacidade/",
      "permanent": true
    },
    {
      "source": "/privacidade.html",
      "destination": "/privacidade/",
      "permanent": true
    },
    {
      "source": "/Privacidade",
      "destination": "/privacidade/",
      "permanent": true
    },
    {
      "source": "/politica-de-privacidade.html",
      "destination": "/privacidade/",
      "permanent": true
    },
    {
      "source": "/Termos.html",
      "destination": "/termos/",
      "permanent": true
    },
    {
      "source": "/termos.html",
      "destination": "/termos/",
      "permanent": true
    },
    {
      "source": "/Termos",
      "destination": "/termos/",
      "permanent": true
    },
    {
      "source": "/termos-de-uso.html",
      "destination": "/termos/",
      "permanent": true
    },
    {
      "source": "/Uso.html",
      "destination": "/termos/",
      "permanent": true
    },
    {
      "source": "/uso.html",
      "destination": "/termos/",
      "permanent": true
    },
    {
      "source": "/Uso",
      "destination": "/termos/",
      "permanent": true
    },
    {
      "source": "/influenciadores(/.*)?",
      "destination": "/criadores/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://ssl.gstatic.com https://www.gstatic.com https://*.clarity.ms https://c.bing.com; style-src 'self' 'unsafe-inline' https://*.googletagmanager.com https://tagmanager.google.com https://fonts.googleapis.com; script-src 'self' https://www.googletagmanager.com https://tagmanager.google.com https://*.clarity.ms https://c.bing.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.clarity.ms https://c.bing.com https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/site.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/site.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/telas/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/hero/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/como-funciona/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/carreira/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/menu/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/blog/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/ilustracoes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/comunidade/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/parceiros/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(u|pt-BR|perfil-antigo)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "teste.hypeapp.com.br"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}