{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "trailingSlash": true,
  "rewrites": [],
  "redirects": [
    {
      "source": "/politica-de-privacidade",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/privacidade/",
      "permanent": true
    },
    {
      "source": "/politica-de-privacidade/:path*",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/privacidade/",
      "permanent": true
    },
    {
      "source": "/privacidade",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/privacidade/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/privacidade/",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/privacidade/",
      "permanent": true
    },
    {
      "source": "/termos-de-uso",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/termos/",
      "permanent": true
    },
    {
      "source": "/termos-de-uso/:path*",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/termos/",
      "permanent": true
    },
    {
      "source": "/termos",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/termos/",
      "permanent": true
    },
    {
      "source": "/terms",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/termos/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "assets.hypeapp.com.br"
        }
      ],
      "destination": "https://www.hypeapp.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/interesse/criadores/:path*",
      "destination": "/baixar/",
      "permanent": false
    },
    {
      "source": "/interesse/marcas/:path*",
      "destination": "/contato/marcas/",
      "permanent": false
    },
    {
      "source": "/interesse/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pre-cadastro/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ajuda/:path*",
      "destination": "/perguntas-frequentes/",
      "permanent": false
    },
    {
      "source": "/como-funciona/",
      "destination": "/criadores/#como-funciona",
      "permanent": false
    },
    {
      "source": "/funcionalidades/",
      "destination": "/marcas/#funcionalidades",
      "permanent": false
    },
    {
      "source": "/contato/parcerias/",
      "destination": "/contato/",
      "permanent": false
    },
    {
      "source": "/direitos-sobre-dados/:path*",
      "destination": "/privacidade/#direitos",
      "permanent": false
    },
    {
      "source": "/mapa-do-site/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/criador/:path*",
      "destination": "/criadores/",
      "permanent": true
    },
    {
      "source": "/creators/:path*",
      "destination": "/criadores/",
      "permanent": true
    },
    {
      "source": "/marca/:path*",
      "destination": "/marcas/",
      "permanent": true
    },
    {
      "source": "/agencias/:path*",
      "destination": "/marcas/#agencias",
      "permanent": true
    },
    {
      "source": "/download/:path*",
      "destination": "/baixar/",
      "permanent": true
    },
    {
      "source": "/login/:path*",
      "destination": "/entrar/",
      "permanent": true
    },
    {
      "source": "/faq/:path*",
      "destination": "/perguntas-frequentes/",
      "permanent": true
    },
    {
      "source": "/politica-de-privacidade/:path*",
      "destination": "/privacidade/",
      "permanent": true
    },
    {
      "source": "/termos-de-uso/:path*",
      "destination": "/termos/",
      "permanent": true
    },
    {
      "source": "/excluir-conta/:path*",
      "destination": "/exclusao-de-conta/",
      "permanent": true
    },
    {
      "source": "/murais-campanhas/:path*",
      "destination": "/criadores/",
      "permanent": true
    },
    {
      "source": "/influenciadores/:path*",
      "destination": "/criadores/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/((?!backoffice).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/telas/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}